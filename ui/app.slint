           MetricPill { label: "GPU"; value: (root.sensors-available && root.gpu-temp >= 0 ? round(root.gpu-temp) + "°C" : "—") + (root.sensors-available && root.gpu-utilization >= 0 ? " · " + round(root.gpu-utilization) + "%" : ""); detail: root.gpu-sensor-provider; hover(h) => { root.hovered-sensor = h ? self.detail : ""; } tint: !root.sensors-available || root.gpu-temp < 0 ? Theme.muted : root.gpu-temp >= 85 ? Theme.danger : root.gpu-temp >= 75 ? Theme.warning : Theme.signal; }
