            x: 8px; y: parent.height - 3px; width: parent.width - 16px; height: 2px; border-radius: 1px; clip: true; background: Theme.cyan.with-alpha(0.08);
            Rectangle { height: 2px; width: parent.width * 0.3; border-radius: 1px;
             x: Theme.motion ? -self.width + (parent.width + self.width) * mod(animation-tick(), 1400ms) / 1400ms : parent.width * 0.35;
             background: @linear-gradient(90deg, Theme.cyan.with-alpha(0.08), Theme.cyan.with-alpha(0.65), Theme.cyan.with-alpha(0.08));
