          VerticalLayout { spacing: 1px; Eyebrow { text: @tr("DEFAULT TIME"); } NumberLabel { text: root.session-default; font-weight: 600; } }
          VerticalLayout { spacing: 1px; Eyebrow { text: @tr("EST. POWER SAVED"); } Label { text: root.energy-savings; color: root.energy-savings-available ? Theme.signal : Theme.muted; } }
