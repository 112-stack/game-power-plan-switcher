         border-width: 1px; border-color: Theme.canvas; drop-shadow-color: Theme.signal.with-alpha(0.4); drop-shadow-blur: 4px;
         opacity: Theme.motion && developer-touch.has-hover ? 0.8 + 0.2 * sin(360deg * animation-tick() / 1600ms) : 1;
