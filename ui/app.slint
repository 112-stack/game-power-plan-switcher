        Card { height: 40px;
         HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
          Rectangle { width: 28px; height: 28px;
           Path { commands: "M 16 4 A 12 12 0 1 1 16 28 A 12 12 0 1 1 16 4"; viewbox-width: 32; viewbox-height: 32; stroke: Theme.border; stroke-width: 3px; fill: transparent; }
