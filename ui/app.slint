       HorizontalLayout {
        padding-left: 10px; padding-right: 4px; padding-top: 2px; padding-bottom: 2px; spacing: 6px;
        Label { text: root.observer ? @tr("Another app window has control.") : @tr("Your previous monitor is running."); color: Theme.warning; font-size: 11px; }
        Action { text: root.observer ? @tr("Take control") : @tr("Use this app instead"); control-height: 28px; ghost: true; clicked => { root.action(root.observer ? "claim" : "handover"); } }
        Rectangle { width: 24px; GhostIcon { y: (parent.height - 24px) / 2; icon: "close"; label: @tr("Dismiss notice"); clicked => { root.dismissed = true; } } }
