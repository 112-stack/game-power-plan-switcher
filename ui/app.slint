           Heading { text: root.active-name; height: 22px; }
           Muted { text: root.handover-pending ? @tr("Handing monitoring to this app…") : root.configuration-pending ? @tr("Applying power settings…") : root.monitoring ? root.process-summary : @tr("Monitoring paused"); height: 12px; }
          }
