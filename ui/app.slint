 callback close-dialog;
 close-dialog => { root.modal = 0; root.plan-kind = -1; main-keys.focus(); }
 keys := FocusScope {
  capture-key-pressed(e) => {
   if root.modal == 14 && root.language-results.length > 0 {
    if e.text == Key.DownArrow { root.language-cursor = min(root.language-cursor + 1, root.language-results.length - 1); return accept; }
    if e.text == Key.UpArrow { root.language-cursor = max(0, root.language-cursor - 1); return accept; }
   }
   if root.plan-kind >= 0 && root.plan-options.length > 0 {
    if e.text == Key.DownArrow { root.plan-index = min(root.plan-index + 1, root.plan-options.length - 1); return accept; }
    if e.text == Key.UpArrow { root.plan-index = max(0, root.plan-index - 1); return accept; }
   } return reject;
  }
  key-pressed(e) => {
   if e.text == Key.Escape { root.close-dialog(); return accept; }
   if e.modifiers.control && e.text == "\n" && !root.dialog-open { root.action("toggle"); return accept; }
   if root.plan-kind >= 0 && root.plan-options.length > 0 {
    if e.text == Key.DownArrow { root.plan-index = min(root.plan-index + 1, root.plan-options.length - 1); return accept; }
    if e.text == Key.UpArrow { root.plan-index = max(0, root.plan-index - 1); return accept; }
    if e.text == "\n" { root.choose-plan(root.plan-index); return accept; }
   } return reject;
  }
  main-keys := FocusScope {
   enabled: !root.dialog-open;
   Rectangle {
    border-radius: 12px; background: Theme.canvas; border-width: 1px; border-color: Theme.border;
    Rectangle { width: parent.width; height: 180px; border-radius: 12px; background: @radial-gradient(circle, #00E5FF09 0%, #00E5FF00 100%); }
    Rectangle { x: parent.width / 2; y: parent.height - 160px; width: parent.width / 2; height: 160px; background: @radial-gradient(circle, #10A37F0B 0%, #10A37F00 100%); }
    VerticalLayout {
     spacing: 0; padding: 1px;
     Rectangle {
      height: 36px; background: @linear-gradient(180deg, Theme.surface, Theme.canvas); border-top-left-radius: 12px; border-top-right-radius: 12px;
      if !root.native-frame: TouchArea { width: parent.width - 280px; pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.window-action(3); } } }
      HorizontalLayout {
       padding-left: 8px; padding-right: 6px; padding-top: 5px; padding-bottom: 5px; spacing: 6px;
       Image { source: @image-url("../assets/icon.png"); width: 26px; height: 26px; image-fit: contain; }
       Label { text: "Game Power Plan Switcher"; font-weight: 600; }
       // Keep the descriptive product title legible even at Compact width.
       Rectangle { horizontal-stretch: 1; }
       Action { text: root.compact-mode ? @tr("Expand") : @tr("Compact"); icon: "maximize"; control-height: 24px; min-width: 28px; preferred-width: 76px; max-width: 88px; ghost: true; clicked => { root.compact-mode = !root.compact-mode; root.layout-mode(root.compact-mode); } }
       GhostIcon { icon: "language"; label: @tr("Language"); clicked => { root.language-query = ""; root.language-filter(""); root.language-cursor = root.language-index; root.modal = 14; } }
       GhostIcon { icon: "theme"; label: root.dark-mode ? @tr("Use light theme") : @tr("Use dark theme"); clicked => { root.dark-mode = !root.dark-mode; root.sync-system-theme = false; root.pro-setting("theme"); } }
       header-status := Action { text: root.handover-pending ? @tr("Taking control…") : root.configuration-pending ? @tr("Applying…") : root.error ? @tr("Attention") : root.state-label; control-height: 24px; min-width: 28px; preferred-width: 70px; max-width: 96px; ghost: true;
        background: root.error || root.handover-pending || root.configuration-pending ? Theme.warning.with-alpha(0.09) : root.monitoring ? Theme.signal.with-alpha(0.09) : Theme.text.with-alpha(0.035);
        border-color: root.error || root.handover-pending || root.configuration-pending ? Theme.warning.with-alpha(0.35) : Theme.border; clicked => { root.modal = 9; }
       }
       shield := GhostIcon { icon: "shield"; label: @tr("Windows process detection details"); clicked => { root.modal = 9; } }
       if !root.native-frame: TrafficLights { minimized => { root.window-action(1); } closed => { root.window-action(0); } }
      }
     }
     HorizontalLayout {
      height: 32px; padding-left: 12px; padding-right: 8px; padding-top: 2px; padding-bottom: 2px; spacing: 6px;
      for label[i] in [@tr("Overview"), @tr("Workspace"), @tr("Settings")]: NavTab { text: label; icon: i == 0 ? "overview" : i == 1 ? "grid" : "settings"; selected: root.page == i; clicked => { root.page = i; } }
      Rectangle { horizontal-stretch: 1; } Eyebrow { text: root.page == 0 ? @tr("LIVE INSIGHTS") : root.page == 1 ? @tr("GAME PROFILES") : @tr("UTILITY CONTROLS"); horizontal-alignment: right; }
     }
     if (root.legacy || root.observer) && root.page == 0 && !root.dismissed && !root.handover-pending: Rectangle {
      height: 32px;
