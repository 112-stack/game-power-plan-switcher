      if root.error: Muted { height: 26px; text: root.status; color: Theme.danger; wrap: word-wrap; }
      if root.modal == 14: VerticalLayout { spacing: 8px;
       Field { in-dialog: true; search: true; text <=> root.language-query; placeholder: @tr("Search languages"); edited(text) => { root.language-filter(text); } accepted => { if root.language-results.length > 0 { root.language-changed(root.language-results[root.language-cursor]); root.close-dialog(); } } }
       if root.language-results.length == 0: Muted { text: @tr("No matching languages"); horizontal-alignment: center; height: 240px; }
       if root.language-results.length > 0: ScrollView { height: 260px; content-width: self.width - 12px; content-height: max(self.height, root.language-results.length * 32px); horizontal-scrollbar-policy: always-off;
        content-y: -max(0px, min(root.language-cursor * 32px - 208px, self.content-height - self.height));
        VerticalLayout { spacing: 4px; padding: 2px;
         for option[i] in root.language-results: Action { in-dialog: true; text: root.language-names[option]; text-font: option == 8 ? "Microsoft YaHei UI" : option == 2 ? "Segoe UI" : Theme.ui-font; icon: option == root.language-index ? "check" : ""; expand: true; align-left: true; selected: i == root.language-cursor;
          clicked => { root.language-changed(option); root.close-dialog(); }
         }
         Rectangle { vertical-stretch: 1; }
        }
       }
       Muted { text: @tr("English is used when a translation is unavailable."); height: 28px; wrap: word-wrap; }
      }
      if root.modal == 13: VerticalLayout { spacing: 8px;
       Eyebrow { text: @tr("LOCAL, READ-ONLY HARDWARE SOURCES"); height: 14px; }
       Label { text: @tr("NVIDIA uses NVML; AMD uses ADL8. GPU measurements become available only when the installed driver exposes them."); wrap: word-wrap; }
       Muted { text: @tr("CPU temperature, package power and board fans need an existing LibreHardwareMonitor or OpenHardwareMonitor WMI provider. This app does not install a driver or request elevation for sensors."); wrap: word-wrap; }
       Rectangle { height: 1px; background: Theme.border; }
       Label { text: @tr("Energy savings need measured energy and a comparison baseline. Temperature or package watts alone cannot establish savings; this value remains unavailable."); wrap: word-wrap; }
       Muted { text: root.provider-status; wrap: word-wrap; }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 28px; spacing: 6px;
        Action { in-dialog: true; text: @tr("Retry local sources"); icon: "refresh"; clicked => { root.pro-command("connect-sensors"); } }
        Action { in-dialog: true; text: @tr("Integrations"); ghost: true; clicked => { root.modal = 0; root.page = 2; root.settings-section = 3; } }
        Rectangle { horizontal-stretch: 1; }
       }
      }
      if root.modal == 12: VerticalLayout { spacing: 10px;
       Heading { text: root.cpu-model; font-size: 18px; height: 44px; wrap: word-wrap; }
       Badge { text: root.cpu-vendor + @tr(" · Windows topology"); }
       Rectangle { height: 1px; background: Theme.border; }
       ScrollView { vertical-stretch: 1; content-width: self.width - 12px; content-height: topology-description.preferred-height; horizontal-scrollbar-policy: always-off;
        topology-description := Label { x: 0px; y: 0px; width: parent.width; text: root.topology-detail; wrap: word-wrap; vertical-alignment: top; }
       }
      }
      if root.modal == 1: VerticalLayout { spacing: 8px;
       // Keep identity separate from metadata: 12px breathing room, then a divider.
       VerticalLayout { height: 69px; spacing: 0px;
        HorizontalLayout { height: 56px; spacing: 12px;
         Rectangle { width: 56px; height: 56px; border-radius: 28px; border-width: 1px; border-color: Theme.border;
          Rectangle { x: 1px; y: 1px; width: 54px; height: 54px; border-radius: 27px; clip: true; Image { source: @image-url("../assets/developer.png"); image-fit: cover; } }
         }
         VerticalLayout { spacing: 3px; alignment: center;
          Heading { height: 24px; text: "Af ✦"; font-family: "Segoe UI Symbol"; font-size: 20px; font-weight: 600; }
          Label { height: 13px; text: "nn6"; font-size: 11px; }
          Muted { height: 13px; text: @tr("Developer of Game Power Plan Switcher"); font-size: 10px; }
         }
        }
        Rectangle { height: 12px; }
        Rectangle { height: 1px; background: Theme.border; }
       }
       // Conditional layouts are supported by Slint 1.18.1; no CSS/FlowLayout.
       profile-badges := Rectangle {
        // Card width is min(440px, window - 24px), with 24px content inset.
        // Use the window breakpoint, not this layout's own measured width,
        // to avoid a conditional layout-info / width dependency cycle.
        private property <bool> stacked: root.width < 428px;
        height: self.stacked ? 84px : 24px;
        if !profile-badges.stacked: HorizontalLayout { spacing: 8px; alignment: start;
         Badge { text: @tr("Member Since May 1, 2016"); }
         Badge { text: "HypeSquad Brilliance"; }
         Badge { text: "Nitro"; }
        }
        if profile-badges.stacked: VerticalLayout { spacing: 6px; alignment: start;
         Badge { text: @tr("Member Since May 1, 2016"); }
         Badge { text: "HypeSquad Brilliance"; }
         Badge { text: "Nitro"; }
        }
       }
       Muted { height: 28px; text: @tr("Nitro since Sep 23, 2026 · Completed a Quest\nFormerly Shadows#2321"); wrap: word-wrap; font-size: 10px; }
       Rectangle { height: 1px; background: Theme.border; }
       HorizontalLayout { height: 28px; spacing: 6px; Action { in-dialog: true; text: @tr("Open Discord profile ↗"); accent: true; control-height: 28px; clicked => { root.action("discord"); } } Rectangle { horizontal-stretch: 1; } }
       HorizontalLayout { height: 28px; spacing: 6px; Action { in-dialog: true; text: @tr("Copy link"); icon: "copy"; ghost: true; control-height: 28px; clicked => { root.action("copy-discord"); } } Action { in-dialog: true; text: "Twitch · mikimeows ↗"; ghost: true; control-height: 28px; clicked => { root.action("twitch"); } } Rectangle { horizontal-stretch: 1; } }
       Rectangle { vertical-stretch: 1; } Muted { text: @tr("Public profile snapshot · verified October 3, 2026"); font-size: 10px; }
      }
      if root.plan-kind >= 0: VerticalLayout { spacing: 6px;
       Muted { height: 14px; text: root.plan-kind == 2 ? @tr("Profile draft · Save profile applies the override.") : root.configuration-pending ? @tr("Applying selection…") : root.monitoring ? @tr("Applying briefly pauses monitoring, then resumes it.") : @tr("Choose a plan to save your selection."); }
       Field { in-dialog: true; text <=> root.plan-search; search: true; placeholder: @tr("Search installed power plans"); edited(s) => { root.plan-filter(s); } accepted => { if root.plan-options.length > 0 { root.choose-plan(root.plan-index); } } }
       if root.plan-options.length == 0: Rectangle { height: 100px; Muted { text: @tr("No matching power plans. Try a different name."); horizontal-alignment: center; } }
       for option[i] in root.plan-options: Action { in-dialog: true; text: option; expand: true; align-left: true; selected: root.plan-index == i; ghost: true; control-height: 28px; changed focused => { if self.focused { root.plan-index = i; } } activated => { root.choose-plan(root.plan-index); } clicked => { root.choose-plan(i); } }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 24px; spacing: 6px;
        Muted { text: @tr("↑ ↓ select · Enter apply · Esc close"); font-size: 10px; }
        GhostIcon { in-dialog: true; icon: "left"; label: @tr("Previous power plans"); enabled: root.plan-back; clicked => { root.action("plan-previous"); } }
        Muted { text: root.plan-page-label; width: 44px; horizontal-alignment: center; }
        GhostIcon { in-dialog: true; icon: "right"; label: @tr("Next power plans"); enabled: root.plan-next; clicked => { root.action("plan-next"); } }
       }
      }
      if root.modal == 2: VerticalLayout { spacing: 6px;
       Field { in-dialog: true; placeholder: @tr("Search name or executable"); search: true; edited(s) => { root.search(s); } }
       if root.candidates.length == 0: Muted { text: @tr("No matching executables. Clear the search or refresh the process/library list."); wrap: word-wrap; }
       for game in root.candidates: Action { in-dialog: true; text: game.name + " · " + game.processes; expand: true; align-left: true; ghost: true; control-height: 28px; clicked => { root.add-candidate(game.id); } }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 24px; spacing: 6px;
        Muted { text: @tr("Review each executable before adding."); font-size: 10px; }
        GhostIcon { in-dialog: true; icon: "left"; label: @tr("Previous candidates"); enabled: root.candidate-back; clicked => { root.action("candidate-previous"); } }
        Muted { text: root.candidate-page-label; width: 44px; horizontal-alignment: center; }
        GhostIcon { in-dialog: true; icon: "right"; label: @tr("Next candidates"); enabled: root.candidate-next; clicked => { root.action("candidate-next"); } }
       }
      }
      if root.modal == 3: VerticalLayout { spacing: 6px;
       Muted { text: root.selected-processes; wrap: word-wrap; }
       Eyebrow { text: @tr("POWER PLAN OVERRIDE"); height: 12px; }
       Action { in-dialog: true; text: root.game-plan-name; icon: "chevron"; expand: true; align-left: true; clicked => { root.modal = 0; root.plan-kind = 2; root.plan-search = ""; root.plan-filter(""); } }
       Eyebrow { text: @tr("PROCESS PRIORITY"); }
       HorizontalLayout { height: 28px; spacing: 6px; for label[i] in [@tr("Default"), @tr("Normal"), @tr("Above"), @tr("High")]: Action { in-dialog: true; text: label; selected: root.priority-index == i; control-height: 28px; clicked => { root.priority-index = i; } } Rectangle { horizontal-stretch: 1; } }
       Eyebrow { text: @tr("CPU AFFINITY"); }
       Field { in-dialog: true; technical: true; text <=> root.affinity-text; placeholder: @tr("Blank, performance, efficiency, physical, or hex mask"); }
       Muted { text: @tr("physical / performance-physical: one thread per physical core\n(single processor group). Restored on stop; Windows may deny changes."); wrap: word-wrap; font-size: 10px; }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 28px; spacing: 6px;
        Action { in-dialog: true; text: @tr("Reset to Default"); icon: "refresh"; ghost: true; clicked => { root.action("profile-reset"); } }
        Rectangle { horizontal-stretch: 1; }
        Action { in-dialog: true; text: @tr("Save profile"); accent: true; control-height: 28px; enabled: !root.configuration-pending && !root.observer; clicked => { root.action("save-game"); } }
       }
      }
      if root.modal == 5: VerticalLayout { spacing: 8px;
       Muted { text: @tr("Add several executables to your workspace at once."); height: 14px; }
       HorizontalLayout { height: 28px; spacing: 6px;
        Field { in-dialog: true; technical: true; text <=> root.bulk-text; invalid: root.bulk-error; placeholder: "RainbowSix.exe, Game.exe"; edited(s) => { root.bulk-edit(s); } accepted => { if root.bulk-valid && !root.observer { root.action("bulk"); } } }
        Action { in-dialog: true; text: @tr("Add"); icon: "plus"; accent: true; enabled: root.bulk-valid && !root.observer; clicked => { root.action("bulk"); } }
       }
       Muted { text: @tr("Separate process names with commas; include .exe."); height: 14px; }
       Rectangle { height: 36px; border-radius: 8px; background: root.bulk-error ? Theme.danger.with-alpha(0.06) : Theme.text.with-alpha(0.025); border-width: 1px; border-color: root.bulk-error ? Theme.danger.with-alpha(0.2) : transparent;
        Muted { x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px; text: root.validation; wrap: word-wrap; color: root.bulk-error ? Theme.danger : Theme.muted; }
       }
       Rectangle { vertical-stretch: 1; }
      }
      if root.modal == 6: VerticalLayout { spacing: 6px;
       Muted { height: 14px; text: root.visual-overlay-available ? @tr("Desktop telemetry overlay available") : @tr("Desktop telemetry overlay unavailable"); }
       ToggleRow { in-dialog: true; text: @tr("Show on-screen overlay"); detail: @tr("Separate from Windows Best performance power mode."); checked: root.visual-overlay-enabled; enabled: root.visual-overlay-available; clicked => { root.visual-overlay-enabled = !root.visual-overlay-enabled; root.pro-setting("visual-overlay"); } }
       Eyebrow { height: 12px; text: @tr("POSITION"); }
       VerticalLayout { spacing: 4px;
        for row in 2: HorizontalLayout { height: 28px; spacing: 4px;
         for col in 2: Action { in-dialog: true; expand: true; text: row == 0 ? (col == 0 ? @tr("Top-left") : @tr("Top-right")) : (col == 0 ? @tr("Bottom-left") : @tr("Bottom-right")); selected: root.overlay-position == row * 2 + col; ghost: true; clicked => { root.overlay-position = row * 2 + col; } }
        }
       }
       HorizontalLayout { height: 28px; spacing: 8px;
        Eyebrow { text: @tr("OPACITY"); width: 55px; }
        Slider { minimum: 0; maximum: 100; step: 1; value <=> root.overlay-opacity; }
        NumberLabel { text: round(root.overlay-opacity) + "%"; width: 34px; horizontal-alignment: right; }
       }
       Field { in-dialog: true; technical: true; text <=> root.overlay-hotkey; placeholder: @tr("Overlay toggle hotkey"); }
       Muted { text: @tr("Monitored full-screen focus pauses HUD; it resumes on return."); height: 14px; }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 28px; Rectangle { horizontal-stretch: 1; } Action { in-dialog: true; text: @tr("Apply overlay"); accent: true; enabled: root.visual-overlay-available && root.hotkeys-available; clicked => { root.pro-setting("overlay-layout"); } } }
      }
      if root.modal == 7: VerticalLayout { spacing: 6px;
       Muted { text: @tr("The same actions are available from the Windows tray icon."); height: 14px; }
       HorizontalLayout { height: 28px; spacing: 6px;
        Action { in-dialog: true; text: @tr("Gaming plan"); icon: "play"; expand: true; ghost: true; enabled: root.tray-available; clicked => { root.pro-command("tray-gaming"); } }
        Action { in-dialog: true; text: @tr("Default plan"); expand: true; ghost: true; enabled: root.tray-available; clicked => { root.pro-command("tray-default"); } }
       }
       Action { in-dialog: true; text: root.monitoring ? @tr("Pause monitoring") : @tr("Resume monitoring"); icon: root.monitoring ? "pause" : "play"; expand: true; align-left: true; ghost: true; enabled: root.tray-available; clicked => { root.pro-command("tray-pause"); } }
       Rectangle { height: 1px; background: Theme.border; }
       Action { in-dialog: true; text: @tr("Exit & restore Default"); icon: "close"; expand: true; align-left: true; ghost: true; danger: true; enabled: root.tray-available; clicked => { root.pro-command("tray-exit"); } }
       Rectangle { vertical-stretch: 1; }
       Muted { text: root.status; height: 14px; }
      }
      if root.modal == 8: VerticalLayout { spacing: 6px;
       Heading { text: root.active-name; height: 24px; }
       HorizontalLayout { height: 24px; Muted { text: root.active-guid; } GhostIcon { in-dialog: true; icon: "copy"; label: @tr("Copy active plan GUID"); clicked => { root.action("copy-guid"); } } }
       Muted { text: root.status; wrap: word-wrap; }
       Rectangle { height: 1px; background: Theme.border; }
       Muted { text: root.session-accounting-label; wrap: word-wrap; }
       Muted { text: @tr("Estimated savings requires an energy meter and a comparison baseline. No estimate is fabricated."); wrap: word-wrap; }
       Rectangle { vertical-stretch: 1; }
       HorizontalLayout { height: 28px; spacing: 6px; Action { in-dialog: true; text: @tr("Export CSV"); icon: "export"; clicked => { root.pro-command("export-csv"); } } Action { in-dialog: true; text: @tr("Export JSON"); ghost: true; clicked => { root.pro-command("export-json"); } } Rectangle { horizontal-stretch: 1; } }
      }
      if root.modal == 9: VerticalLayout { spacing: 6px;
       Label { text: root.state-label; height: 16px; color: root.error ? Theme.warning : Theme.signal; }
       Muted { text: root.status; wrap: word-wrap; }
       Rectangle { height: 1px; background: Theme.border; }
       Label { text: root.detector-label; height: 16px; }
       Muted { text: @tr("Process detection uses Windows WMI / Win32 APIs. No game injection, game-memory scanning or kernel driver is used for detection."); wrap: word-wrap; }
       Muted { text: @tr("Anti-cheat compatibility is not certified. API choice cannot guarantee that an application will avoid a game ban. Optional per-game scheduling changes are a separate feature."); wrap: word-wrap; }
       Rectangle { vertical-stretch: 1; }
      }
      if root.modal == 10: VerticalLayout { spacing: 6px;
       Muted { height: 14px; text: @tr("Newest first · select a recorded event to inspect details"); }
       ScrollView { vertical-stretch: 1; content-width: self.width - 12px; content-height: max(self.height, root.history.length * 34px); horizontal-scrollbar-policy: always-off;
        for event[i] in root.history: Action { y: i * 34px; width: parent.width; control-height: 28px; in-dialog: true; text: event.label + " · " + event.detail; expand: true; align-left: true; ghost: true; clicked => { root.event-selected(i); root.modal = 11; } }
        if root.history.length == 0: Muted { text: @tr("No recorded transitions in this session."); horizontal-alignment: center; }
       }
       HorizontalLayout { height: 28px; spacing: 6px; Action { in-dialog: true; text: @tr("Open activity log"); icon: "external"; ghost: true; clicked => { root.action("log"); } } Action { in-dialog: true; text: @tr("Export diagnostics"); ghost: true; clicked => { root.pro-command("export-diagnostics"); } } Rectangle { horizontal-stretch: 1; } }
      }
      if root.modal == 11: VerticalLayout { spacing: 6px;
       Card { vertical-stretch: 1;
        Label { x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px; text: root.event-detail; font-size: 11px; wrap: word-wrap; vertical-alignment: top; }
       }
       HorizontalLayout { height: 28px; spacing: 6px;
        Action { in-dialog: true; text: @tr("All events"); icon: "left"; ghost: true; clicked => { root.modal = 10; } }
        Rectangle { horizontal-stretch: 1; }
        Action { in-dialog: true; text: @tr("Export diagnostics"); icon: "export"; clicked => { root.pro-command("export-diagnostics"); } }
        }
      }
      if root.modal == 4: VerticalLayout { spacing: 8px;
       HorizontalLayout { height: 48px; spacing: 12px; Image { source: @image-url("../assets/icon.png"); width: 40px; height: 40px; image-fit: contain; } VerticalLayout { spacing: 4px; Heading { text: "Game Power Plan Switcher"; } Muted { text: @tr("Version 2.3.7 · Native Windows desktop"); } } }
       Muted { text: @tr("Application source: GPL-3.0-or-later · © NN6\nRust + C++23 · Slint under GPLv3."); wrap: word-wrap; }
       HorizontalLayout { height: 28px; Action { in-dialog: true; text: @tr("Dependency licenses"); ghost: true; control-height: 28px; clicked => { root.action("licenses"); } } Rectangle { horizontal-stretch: 1; } }
       Rectangle { height: 1px; background: Theme.border; } AboutSlint { }
      }
     }
    }
   }
  }
 }
}
