 drop-shadow-blur: root.focused ? 9px : root.hovered ? 7px : 4px; drop-shadow-offset-y: root.focused ? 0px : 2px;
 animate background, border-color, transform-scale, drop-shadow-color, drop-shadow-blur, drop-shadow-offset-y { duration: Theme.motion ? 130ms : 0ms; easing: ease-out; }
 Rectangle { x: 12px; y: 1px; width: parent.width - 24px; height: 1px; background: @linear-gradient(90deg, #FFFFFF00, #FFFFFF20, #FFFFFF00); }
