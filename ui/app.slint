        Card { min-height: 50px; vertical-stretch: 1;
         VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
          HorizontalLayout { height: 14px; Eyebrow { text: @tr("POWER TIMELINE"); } Muted { text: @tr("Select an event for details"); horizontal-alignment: right; } GhostIcon { icon: "chevron"; width: 18px; height: 16px; label: @tr("All power events"); clicked => { root.modal = 10; } } }
