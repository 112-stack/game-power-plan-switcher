  if root.icon != "" && !(root.align-left && root.icon == "chevron"): Rectangle { width: 16px; Icon { y: (parent.height - self.height) / 2; kind: root.icon; stroke: root.danger ? Theme.danger : root.accent ? #082C23 : Theme.text; } }
  caption := Label { text: root.text; font-family: root.text-font; horizontal-stretch: root.expand ? 1 : 0; horizontal-alignment: root.align-left ? (Theme.rtl ? right : left) : center; color: root.danger ? Theme.danger : root.accent ? #082C23 : Theme.text; font-size: 11px; font-weight: root.accent ? 600 : 400; }
