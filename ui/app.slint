            border-width: 1px; border-color: core.fill.with-alpha(0.26);
            Rectangle { x: 3px; y: 10px; height: 5px; width: max(0px, (parent.width - 6px) * core.activity); border-radius: 2.5px; background: root.heatmap-view ? transparent : parent.load-tint.with-alpha(0.3);
             animate width, background { duration: Theme.motion ? 130ms : 0ms; easing: ease-out; }
            }
            if !root.heatmap-view: NumberLabel { text: core.label; font-size: 10px; color: core.activity >= 0 ? Theme.text : Theme.muted; horizontal-alignment: center; }
