           HorizontalLayout { height: 28px; spacing: 6px;
            Action { text: root.monitoring ? @tr("Pause") : @tr("Start monitoring"); icon: root.monitoring ? "pause" : "play"; accent: true; enabled: root.connected && !root.observer && !root.handover-pending && !root.configuration-pending; clicked => { root.action("toggle"); } }
            Action { text: root.startup ? @tr("Startup on") : @tr("Startup"); icon: root.startup ? "check" : "plus"; enabled: root.connected && !root.observer && !root.handover-pending; clicked => { root.action("startup"); } }
