// Game Power Plan Switcher 2.3.7 / adaptive Obsidian Glass. Native utility with real dark/light themes.
// Fixed-height controls prevent accidental layout expansion. I/O stays in Rust.
import { AboutSlint, Palette, Slider, ScrollView } from "std-widgets.slint";
export struct GameRow { id: string, name: string, processes: string, icon: image, selected: bool }
export struct CoreRow { label: string, fill: color, activity: float, detail: string, class: string }
export struct CoreSection { title: string, detail: string, class: string, start: int, count: int, rows-8: int, rows-12: int, rows-16: int }
export struct HistoryRow { label: string, detail: string, level: float, gaming: bool }
export global Shortcuts { callback monitor; }
export global Theme {
 in-out property <bool> dark: true;
 in-out property <bool> rtl: false;
 in-out property <string> ui-font: "Segoe UI";
 in-out property <string> mono-font: "Consolas";
 out property <color> canvas: root.dark ? #0B0D12 : #F5F5F7;
 out property <color> surface: root.dark ? #12151E : #FFFFFF;
 out property <color> elevated: root.dark ? #1A1F2C : #E9EBEF;
 out property <color> border: root.dark ? #2A3042 : #D9DCE3;
 out property <color> text: root.dark ? #FFFFFF : #1D1D1F;
 out property <color> muted: root.dark ? #A0A5B0 : #626873;
 out property <color> emerald: #10A37F;
 out property <color> signal: root.dark ? #00FF9D : #007B58;
 out property <color> cyan: root.dark ? #00E5FF : #007F96;
 out property <color> warning: root.dark ? #FFB800 : #916400;
 out property <color> danger: root.dark ? #FF928C : #B52F2A;
 out property <color> highlight: root.dark ? #FFFFFF16 : #FFFFFFBB;
 out property <color> shade: root.dark ? #00000099 : #15223817;
 in-out property <bool> motion: true; in-out property <bool> modal-open: false;
}
export component FullscreenProbe inherits Window {
 title: "Game Power Plan Switcher disposable fullscreen probe"; full-screen: true; background: #12151E;
 Text { text: "Game Power Plan Switcher full-screen rendering test\nThis disposable window closes automatically."; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 24px; }
}
// Rust supplies live text and controls topmost/click-through placement natively.
export component TelemetryHud inherits Window {
 title: @tr("Game Power Plan Switcher telemetry"); no-frame: true; background: transparent;
 preferred-width: 220px; preferred-height: 72px;
 in property <string> plan-name; in property <string> cpu-text; in property <string> sensor-text;
 in property <float> alpha: 0.75;
 Rectangle { border-radius: 12px; background: #161D25.with-alpha(clamp(root.alpha, 0.05, 1)); border-width: 1px; border-color: #FFFFFF24;
  VerticalLayout { padding: 10px; spacing: 3px;
   Text { text: root.plan-name; font-family: Theme.ui-font; color: #74EBC5; font-size: 11px; overflow: elide; }
   Text { text: root.cpu-text; font-family: Theme.ui-font; color: white; font-size: 11px; overflow: elide; }
   Text { text: root.sensor-text; font-family: Theme.ui-font; color: #BCC4D0; font-size: 10px; overflow: elide; }
  }
 }
}
component Label inherits Text { color: Theme.text; font-family: Theme.ui-font; font-size: 11px; font-weight: 400; horizontal-alignment: Theme.rtl ? right : left; vertical-alignment: center; min-width: 0px; overflow: elide; }
component Muted inherits Label { color: Theme.muted; font-size: 10px; font-weight: 500; letter-spacing: 0.2px; }
component NumberLabel inherits Label { font-family: Theme.mono-font; horizontal-alignment: left; }
component Heading inherits Label { font-size: 18px; font-weight: 500; letter-spacing: -0.5px; }
component Eyebrow inherits Muted { letter-spacing: 1px; font-weight: 600; }
component Icon inherits Path {
 in property <string> kind; width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24;
 stroke: Theme.muted; stroke-width: 1.7px; fill: transparent;
 commands: root.kind == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
 : root.kind == "language" ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 M 3 12 L 21 12 M 12 3 C 6 8 6 16 12 21 M 12 3 C 18 8 18 16 12 21"
 : root.kind == "minimize" ? "M 5 12 L 19 12"
 : root.kind == "info" ? "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 M 12 10 L 12 17 M 12 6 L 12 7"
 : root.kind == "maximize" ? "M 6 6 L 18 6 L 18 18 L 6 18 Z"
 : root.kind == "theme" ? "M 16 3 A 9 9 0 1 0 21 16 A 8 8 0 0 1 16 3 Z"
 : root.kind == "heatmap" ? "M 4 4 L 9 4 L 9 9 L 4 9 Z M 15 4 L 20 4 L 20 9 L 15 9 Z M 4 15 L 9 15 L 9 20 L 4 20 Z M 15 15 L 20 15 L 20 20 L 15 20 Z"
 : root.kind == "play" ? "M 7 4 L 20 12 L 7 20 Z"
 : root.kind == "pause" ? "M 8 5 L 8 19 M 16 5 L 16 19"
 : root.kind == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
 : root.kind == "check" ? "M 5 12 L 10 17 L 20 6"
 : root.kind == "left" ? "M 15 5 L 8 12 L 15 19"
 : root.kind == "right" ? "M 9 5 L 16 12 L 9 19"
 : root.kind == "refresh" ? "M 20 10 A 8 8 0 1 0 19 17 M 20 4 L 20 10 L 14 10"
 : root.kind == "search" ? "M 10 3 A 7 7 0 1 0 10 17 A 7 7 0 1 0 10 3 M 15 15 L 21 21"
 : root.kind == "overview" ? "M 3 4 L 21 4 L 21 20 L 3 20 Z M 3 10 L 21 10 M 10 10 L 10 20"
 : root.kind == "grid" ? "M 3 3 L 9 3 L 9 9 L 3 9 Z M 15 3 L 21 3 L 21 9 L 15 9 Z M 3 15 L 9 15 L 9 21 L 3 21 Z M 15 15 L 21 15 L 21 21 L 15 21 Z"
 : root.kind == "settings" ? "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 20 18 M 8 3 L 8 9 M 16 9 L 16 15 M 10 15 L 10 21"
 : root.kind == "shield" ? "M 12 2 L 20 5 L 19 14 Q 17 19 12 22 Q 7 19 5 14 L 4 5 Z M 8 12 L 11 15 L 16 9"
 : root.kind == "export" ? "M 12 3 L 12 15 M 7 10 L 12 15 L 17 10 M 4 16 L 4 21 L 20 21 L 20 16"
 : root.kind == "external" ? "M 13 3 L 21 3 L 21 11 M 21 3 L 10 14 M 10 5 L 4 5 L 4 21 L 19 21 L 19 15"
 : root.kind == "chevron" ? "M 6 9 L 12 15 L 18 9"
 : "M 8 3 L 20 3 L 20 16 L 8 16 Z M 4 8 L 4 21 L 15 21";
}
