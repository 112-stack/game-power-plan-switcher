           MetricPill { label: root.gpu-fan-rpm >= 0 || root.gpu-fan-percent >= 0 ? @tr("GPU fan") : @tr("Fan"); value: !root.sensors-available ? "—" : root.gpu-fan-rpm >= 0 ? round(root.gpu-fan-rpm) + " RPM" : root.gpu-fan-percent >= 0 ? round(root.gpu-fan-percent) + "%" : root.fan-rpm >= 0 ? round(root.fan-rpm) + " RPM" : "—"; detail: root.fan-sensor-provider; hover(h) => { root.hovered-sensor = h ? self.detail : ""; } }
          }
