           Path { width: parent.width; height: parent.height; viewbox-width: 600; viewbox-height: 100; fit: fill; commands: root.cpu-switch-path; stroke: Theme.warning.with-alpha(0.65); stroke-width: 1px; fill: transparent; }
           Path { width: parent.width; height: parent.height; viewbox-width: 600; viewbox-height: 100; fit: fill; commands: root.cpu-trend-path; stroke: Theme.muted.with-alpha(0.65); stroke-width: 1px; fill: transparent; }
           Path { width: parent.width; height: parent.height; viewbox-width: 600; viewbox-height: 100; fit: fill; commands: root.cpu-p-trend-path; stroke: Theme.signal; stroke-width: 1.5px; fill: transparent; }
           Path { width: parent.width; height: parent.height; viewbox-width: 600; viewbox-height: 100; fit: fill; commands: root.cpu-e-trend-path; stroke: Theme.cyan; stroke-width: 1.5px; fill: transparent; }
           if !root.cpu-trend-available: Muted { text: @tr("Collecting real Windows CPU samples…"); horizontal-alignment: center; }
